# Path to the directory containing the CSV exports.
SOURCE_DIR=/data/testfile

# Warehouse URL holding Bridge / Source / Error schemas.
# REQUIRED — no fallback. Must be a PostgreSQL SQLAlchemy URL.
TARGET_CONNECTION_STRING=postgresql://USER:PASSWORD@HOSTNAME:5432/warehouse

BRIDGE_SCHEMA=bridge
TARGET_SOURCE_SCHEMA=source
ERROR_SCHEMA=error

# Short system token baked into physical table names:
#   <stage>_tbl_<SOURCE_NAME>_<base>
SOURCE_NAME=testfile

LOG_LEVEL=INFO
