{
  "templateType": "zip_csv",
  "sequencePolicy": "truncate_once_then_append",
  "tables": [
    {
      "tableName": "tbl_testfile_full_results",
      "description": "testfile full results data"
    }
  ],
  "options": {
    "caseInsensitiveColumns": true,
    "enableColumnValidation": true,
    "unknownFileAction": "skip",
    "encoding": "utf-8"
  },
  "fileNamingConvention": "testfile_YYYYMMDD.zip",
  "delimiter": ",",
  "quoteChar": "\"",
  "escapeChar": "\\"
}