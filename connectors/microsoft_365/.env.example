# ─────────────────────────────────────────────────────────────────
# Microsoft 365 connector — environment variables
# ─────────────────────────────────────────────────────────────────

# ── SAM Studio credentials (set via the Studio UI) ────────────────
# These are the exact field names the SAM Studio Credentials dialog
# uses for `Microsoft 365`. config.py resolves auth from them via
# multi-name fallbacks, so re-adding the connector and re-generating
# code keeps the .env you already filled in working unchanged.

# API Base URL (required)
base_url=

# API Key / Token (required)
api_key=

# Username (optional) (optional)
username=

# Password (optional) (optional)
password=


# ── Source API base URL ───────────────────────────────────────────
# Fully-resolved URL of the source API. No trailing slash.
API_BASE_URL=https://graph.microsoft.com/v1.0

# ── Source API authentication ─────────────────────────────────────
# Pick the ONE flow your API uses and uncomment those lines.

# (A) Pre-issued bearer token
# AUTH_TOKEN=

# (B) HTTP Basic Auth
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# (C) OAuth2 client credentials
# TENANT_ID=
# CLIENT_ID=
# CLIENT_SECRET=
# OAUTH_SCOPE=

# (D) Static query-string token (e.g. BigFix `?token=...`).
# NOTE: static / operator-provided only — no login handshake.
# API_QUERY_TOKEN=
# API_QUERY_TOKEN_NAME=token

# Path-parameter substitutions (only if your endpoints use {subscriptionId} etc.)
# SUBSCRIPTION_ID=

# ── Target warehouse (Bridge / Source / Error / ETL) ──────────────
# REQUIRED. Must be a PostgreSQL SQLAlchemy URL.
TARGET_CONNECTION_STRING=postgresql://USER:PASSWORD@HOSTNAME:5432/warehouse

BRIDGE_SCHEMA=bridge
TARGET_SOURCE_SCHEMA=source
ERROR_SCHEMA=error

# Short system token baked into physical table names:
#   <stage>_tbl_<SOURCE_NAME>_<base>
SOURCE_NAME=microsoft_365

# Pagination guardrails
MAX_PAGES=200
PAGE_SIZE=100
REQUEST_TIMEOUT=30
HTTP_RETRIES=3

LOG_LEVEL=INFO
